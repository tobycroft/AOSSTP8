APP_DEBUG = true

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8

DEFAULT_LANG = zh-cn

# 缓存驱动：file（默认）或 redis
CACHE_DRIVER = file
# 缓存前缀（共享 Redis 时务必设置，避免键冲突）
CACHE_PREFIX = 
# 缓存有效期（秒，0 表示永久）
CACHE_EXPIRE = 0
# Redis 连接配置（CACHE_DRIVER = redis 时生效）
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD = 
# 库序号，建议指定独立库，避免清空缓存时 flushDB 影响其他应用
REDIS_SELECT = 0
REDIS_TIMEOUT = 0
# Redis 长连接：true / false
CACHE_REDIS_PERSISTENT = false

# V3 附件分发（虚拟地址 + X-Accel-Redirect）
# 域名按实际部署填写；nginx 需要 internal location 与 ATTACH_INTERNAL_PREFIX 一致
ATTACH_DOMAIN = https://attach.tuuz.cc
ATTACH_INTERNAL_PREFIX = /_aoss_internal_attachment/
# 留空表示 public/upload
ATTACH_UPLOAD_ROOT =
# 取件码默认/最大有效期（秒），虚拟地址缓存时间（秒）
ATTACH_TTL = 3600
ATTACH_MAX_TTL = 604800
ATTACH_CACHE_TTL = 86400

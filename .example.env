APP_DEBUG = true

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8

DEFAULT_LANG = zh-cn

# 缓存驱动：file（默认）或 redis
CACHE_DRIVER = file
# 缓存前缀（共享 Redis 时务必设置，避免键冲突）
CACHE_PREFIX = 
# 缓存有效期（秒，0 表示永久）
CACHE_EXPIRE = 0
# Redis 连接配置（CACHE_DRIVER = redis 时生效）
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD = 
# 库序号，建议指定独立库，避免 clear() 的 flushDB 影响其他应用
REDIS_SELECT = 0
REDIS_TIMEOUT = 0
# Redis 长连接：true / false
CACHE_REDIS_PERSISTENT = false
